# Google Gemini Configuration
# You can set either GEMINI_API_KEY or GOOGLE_API_KEY
GOOGLE_API_KEY=your_google_api_key_here
# Configurable model: "gemini-3.8-flash" (default) or "gemini-3.5-flash-lite"
GEMINI_MODEL=gemini-3.8-flash

# LangSmith Observability & Tracing (Optional but highly recommended)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=enterprise-expense-auditor

# Application Settings
LOG_LEVEL=INFO
